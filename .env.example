# 이 파일을 복사해서 .env로 사용한다. 실제 .env는 git에 커밋하지 않는다.
#   cp .env.example .env

# ===== MySQL (infra/docker-compose.yml + Spring datasource 공용) =====
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=gonggomoa
MYSQL_USER=gonggomoa
MYSQL_PASSWORD=changeme
MYSQL_PORT=3306

# ===== Spring Boot datasource (docker-compose 값과 맞춰서 사용) =====
DB_URL=jdbc:mysql://localhost:3306/gonggomoa
DB_USERNAME=gonggomoa
DB_PASSWORD=changeme

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 재정경제부_공공기관 채용정보 API (data.go.kr) =====
# 공공데이터포털 마이페이지에서 발급받은 서비스키를 넣는다. Encoding/Decoding 두 종류가
# 있는데, 401이 나면 다른 종류로 바꿔서 시도한다 (spike/api-explore.http 참고).
MOEF_SERVICE_KEY=

# ===== 디스코드 배치 실패 알림 (ADR-0005) =====
# 알림 받을 디스코드 채널에서 "연동 > 웹훅 > 새 웹훅"으로 발급받은 URL을 넣는다.
# 비워두면 알림이 비활성화될 뿐 배치는 정상 동작한다. 이 URL 자체가 시크릿이다 —
# 아는 사람 누구나 해당 채널에 메시지를 보낼 수 있으니 커밋·로그에 남기지 않는다.
DISCORD_WEBHOOK_URL=
